# Скопируйте этот файл в .env и заполните параметры.
# В путях Windows используйте / вместо \

# Локальная папка, которую нужно синхронизировать
LOCAL_FOLDER=C:/Users/user/Documents/sync
# Папка на Яндекс Диске для резервных копий (должна существовать)
CLOUD_FOLDER=backup
# OAuth-токен Яндекс Диска: https://yandex.ru/dev/disk/poligon/
TOKEN=
# Период синхронизации в секундах
SYNC_PERIOD=60
# Путь к файлу лога
LOG_FILE=sync.log
